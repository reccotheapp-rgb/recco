{
  "expo": {
    "name": "Recco",
    "slug": "recco",
    "version": "0.3.3",
    "orientation": "portrait",
    "icon": "./assets/recco-mark-v1.png",
    "description": "Your media life, all in one place.",
    "scheme": "recco",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.reccotheapp.recco",
      "versionCode": 12,
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "backgroundColor": "#0E1513",
        "foregroundImage": "./assets/recco-mark-v1.png",
        "monochromeImage": "./assets/recco-mark-v1.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-notifications",
      [
        "expo-navigation-bar",
        {
          "enforceContrast": false,
          "style": "light"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "26243ec6-0a27-435e-9edc-6c018d9d0086"
      }
    },
    "owner": "marlowdagoats-team"
  }
}
